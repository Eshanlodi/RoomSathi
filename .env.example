# Server
PORT=5000
NODE_ENV=development

# MongoDB (get a free connection string from MongoDB Atlas)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/roomsathi

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS)
CLIENT_URL=https://student-helper-roomsathi.vercel.app
